<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " · RAIN" : "💧 RAIN WaterTracker")</title>

    <!-- PWA & iOS Meta Etiketleri -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#5B9BD5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="RAIN" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @RenderBody()

    <!-- PWA Service Worker kaydı -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>

    <script src="~/js/dashboard.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Somee.com Reklam Gizleyici -->
    <style>
        div[style*="z-index: 9999999"], 
        div[style*="z-index:9999999"], 
        body > center,
        div[style*="height: 65px;"] {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
            height: 0 !important;
            width: 0 !important;
            pointer-events: none !important;
        }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let removeAds = function() {
                // Center etiketlerini temizle
                document.querySelectorAll("center").forEach(function(c) {
                    if(c.innerText.includes("somee") || c.innerText.includes("Hosted Windows")) {
                        c.style.display = "none";
                    }
                });
                // Sonradan eklenen z-indexli script ve div'leri temizle
                document.querySelectorAll('script[src*="somee.com"]').forEach(s => s.remove());
                let allDivs = document.querySelectorAll("div");
                allDivs.forEach(function(d) {
                    if(d.style.zIndex == "9999999" || (d.innerText && d.innerText.includes("somee.com"))) {
                        d.style.display = "none";
                    }
                });
            };
            removeAds();
            setTimeout(removeAds, 500);
            setTimeout(removeAds, 2000);
            setInterval(removeAds, 5000);
        });
    </script>
</body>
</html>
