@{
    ViewBag.Title = "Giriş Yap";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RAIN WaterTracker — Giriş</title>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">

    <div class="wave-container">
        <div class="wave wave1"></div>
        <div class="wave wave2"></div>
        <div class="wave wave3"></div>
    </div>

    <div class="bubbles">
        @for (int i = 0; i < 12; i++)
        {
            <div class="bubble" style="--delay:@(i * 0.4)s; --size:@(20 + i * 8)px; --left:@(i * 8 + 2)%"></div>
        }
    </div>

    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-header">
                <div class="drop-icon">🌧️</div>
                <h1>RAIN</h1>
                <p class="login-subtitle">Water Tracker</p>
                <p class="login-tagline">Suyunu takip et, sağlıklı yaşa</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error-banner">@ViewBag.Error</div>
            }

            <form method="post" action="/Auth/Login" class="login-form">
                <div class="input-group">
                    <span class="input-icon">👤</span>
                    <input type="text" name="username" placeholder="Kullanıcı adı"
                           autocomplete="username" required />
                </div>
                <div class="input-group">
                    <span class="input-icon">🔒</span>
                    <input type="password" name="password" placeholder="Şifre"
                           autocomplete="current-password" required />
                </div>
                <button type="submit" class="login-btn">
                    <span>Giriş Yap</span>
                    <span class="btn-arrow">→</span>
                </button>
            </form>

            <p class="login-hint">
                <code>taki</code> veya <code>yagmur</code> · şifre: <code>sifre123</code>
            </p>
        </div>
    </div>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>
</body>
</html>
